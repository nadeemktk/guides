# =============================================================================
# AISeen — Environment Variables Template
# Copy to .env.local and fill in values. Never commit .env.local to git.
# =============================================================================

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# LLM APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GEMINI_API_KEY=AIza...
PERPLEXITY_API_KEY=pplx-...
SERPAPI_KEY=...

# Inngest (https://app.inngest.com)
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-prod-...

# Shopify App credentials
SHOPIFY_API_KEY=...
SHOPIFY_API_SECRET=...
SHOPIFY_APP_URL=https://your-app.vercel.app

# Amazon SP-API — LWA credentials are stored per-seller in stores.api_credentials
# IAM credentials are app-level and used to sign SP-API requests via SigV4
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Email (https://resend.com)
RESEND_API_KEY=re_...

# Upstash Redis (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Error monitoring (https://sentry.io)
SENTRY_DSN=https://...@sentry.io/...

# Analytics (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
