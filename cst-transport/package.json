{
  "name": "cst-transport",
  "version": "1.0.0",
  "description": "City Star Transport Passengers LLC – Enterprise Transport Management System",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron-wait-vite\"",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.node.json && vite build && electron-builder",
    "build:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false tsc -p tsconfig.node.json && vite build && electron-builder --win",
    "preview": "vite preview",
    "seed": "ts-node scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["transport", "management", "electron", "desktop"],
  "author": "City Star Transport Passengers LLC",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "better-sqlite3": "^9.4.3",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.344.0",
    "nodemailer": "^6.9.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.25",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.citystar.transport",
    "productName": "CST Transport Manager",
    "asar": true,
    "asarUnpack": ["**/node_modules/better-sqlite3/**"],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
